<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 900" preserveAspectRatio="xMidYMid slice" role="img" aria-label="人生診断士の5領域フレームワーク">
  <defs>
    <linearGradient id="bg2" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F3F6F1"/>
    </linearGradient>
    <radialGradient id="ring" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" stop-color="#278D44" stop-opacity=".05"/>
      <stop offset="100%" stop-color="#278D44" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid2" width="50" height="50" patternUnits="userSpaceOnUse">
      <path d="M50 0 L0 0 0 50" fill="none" stroke="#1a1a1a" stroke-opacity=".04" stroke-width="1"/>
    </pattern>
  </defs>

  <rect width="1000" height="900" fill="url(#bg2)"/>
  <rect width="1000" height="900" fill="url(#grid2)"/>

  <!-- Outer halo -->
  <circle cx="500" cy="450" r="380" fill="url(#ring)"/>
  <circle cx="500" cy="450" r="320" fill="none" stroke="#278D44" stroke-width="1" opacity=".25" stroke-dasharray="2 6"/>
  <circle cx="500" cy="450" r="260" fill="none" stroke="#278D44" stroke-width="1.2" opacity=".5"/>

  <!-- Pentagon outline (5 domains) -->
  <g transform="translate(500 450)">
    <polygon points="0,-220 209,-68 129,178 -129,178 -209,-68"
             fill="none" stroke="#1a1a1a" stroke-width="2" opacity=".75"/>
    <polygon points="0,-220 209,-68 129,178 -129,178 -209,-68"
             fill="#278D44" opacity=".06"/>

    <!-- Lines from center to vertices -->
    <line x1="0" y1="0" x2="0" y2="-220" stroke="#278D44" stroke-width="1.5" opacity=".4"/>
    <line x1="0" y1="0" x2="209" y2="-68" stroke="#278D44" stroke-width="1.5" opacity=".4"/>
    <line x1="0" y1="0" x2="129" y2="178" stroke="#278D44" stroke-width="1.5" opacity=".4"/>
    <line x1="0" y1="0" x2="-129" y2="178" stroke="#278D44" stroke-width="1.5" opacity=".4"/>
    <line x1="0" y1="0" x2="-209" y2="-68" stroke="#278D44" stroke-width="1.5" opacity=".4"/>

    <!-- Center diamond (the Diagnostician's eye) -->
    <circle cx="0" cy="0" r="34" fill="#1a1a1a"/>
    <circle cx="0" cy="0" r="22" fill="none" stroke="#278D44" stroke-width="2"/>
    <circle cx="0" cy="0" r="6" fill="#278D44"/>
  </g>

  <!-- 5 Domain icons at vertices -->
  <!-- 健康 (top) -->
  <g transform="translate(500 230)">
    <circle r="38" fill="#FFFFFF" stroke="#278D44" stroke-width="2"/>
    <path d="M-13 -3 a8 8 0 1 1 13 -8 a8 8 0 1 1 13 8 c0 8 -13 18 -13 18 s-13 -10 -13 -18" fill="#278D44"/>
    <text y="65" text-anchor="middle" font-family="Shippori Mincho, serif" font-size="14" font-weight="700" fill="#1a1a1a" letter-spacing="2">健康</text>
  </g>
  <!-- お金 (top-right) -->
  <g transform="translate(709 382)">
    <circle r="38" fill="#FFFFFF" stroke="#278D44" stroke-width="2"/>
    <text y="6" text-anchor="middle" font-family="Bebas Neue, sans-serif" font-size="28" fill="#278D44">¥</text>
    <text y="62" text-anchor="middle" font-family="Shippori Mincho, serif" font-size="14" font-weight="700" fill="#1a1a1a" letter-spacing="2">お金</text>
  </g>
  <!-- 家族 (bottom-right) -->
  <g transform="translate(629 628)">
    <circle r="38" fill="#FFFFFF" stroke="#278D44" stroke-width="2"/>
    <path d="M-15 -10 L0 -22 L15 -10 L15 12 L-15 12 Z" fill="none" stroke="#278D44" stroke-width="2"/>
    <rect x="-5" y="0" width="10" height="12" fill="#278D44"/>
    <text y="62" text-anchor="middle" font-family="Shippori Mincho, serif" font-size="14" font-weight="700" fill="#1a1a1a" letter-spacing="2">家族</text>
  </g>
  <!-- キャリア (bottom-left) -->
  <g transform="translate(371 628)">
    <circle r="38" fill="#FFFFFF" stroke="#278D44" stroke-width="2"/>
    <rect x="-14" y="-6" width="28" height="20" fill="none" stroke="#278D44" stroke-width="2" rx="2"/>
    <path d="M-7 -6 V-12 H7 V-6" fill="none" stroke="#278D44" stroke-width="2"/>
    <text y="62" text-anchor="middle" font-family="Shippori Mincho, serif" font-size="14" font-weight="700" fill="#1a1a1a" letter-spacing="2">キャリア</text>
  </g>
  <!-- 働き方 (top-left) -->
  <g transform="translate(291 382)">
    <circle r="38" fill="#FFFFFF" stroke="#278D44" stroke-width="2"/>
    <circle r="9" fill="#278D44"/>
    <g stroke="#278D44" stroke-width="2" stroke-linecap="round">
      <line x1="0" y1="-19" x2="0" y2="-13"/>
      <line x1="0" y1="13" x2="0" y2="19"/>
      <line x1="-19" y1="0" x2="-13" y2="0"/>
      <line x1="13" y1="0" x2="19" y2="0"/>
      <line x1="-13" y1="-13" x2="-9" y2="-9"/>
      <line x1="9" y1="9" x2="13" y2="13"/>
      <line x1="-13" y1="13" x2="-9" y2="9"/>
      <line x1="9" y1="-9" x2="13" y2="-13"/>
    </g>
    <text y="62" text-anchor="middle" font-family="Shippori Mincho, serif" font-size="14" font-weight="700" fill="#1a1a1a" letter-spacing="2">働き方</text>
  </g>

  <!-- Editorial labels -->
  <g font-family="Cormorant Garamond, serif" fill="#1B6A17" letter-spacing="6">
    <text x="60" y="80" font-size="16" font-style="italic">— Five Life Domains</text>
    <text x="60" y="108" font-family="Bebas Neue, sans-serif" font-size="11" fill="#1a1a1a" letter-spacing="4">JINSEI SHINDANSHI · FRAMEWORK</text>
  </g>
  <g font-family="Bebas Neue, sans-serif" font-size="11" fill="#1a1a1a" letter-spacing="3">
    <line x1="860" y1="840" x2="940" y2="840" stroke="#278D44" stroke-width="2"/>
    <text x="855" y="843" text-anchor="end">PENTAGON MODEL</text>
  </g>
</svg>
